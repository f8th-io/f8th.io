---
// Footer: no logo, no links to build out — just the copyright year and the
// license split (code vs. written content are licensed differently; see
// LICENSE and LICENSE-CONTENT in the repo).
//
// The year is computed at BUILD time. The site is static, so the year
// refreshes on each deploy — no client JavaScript needed.
import { AUTHOR } from "../consts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>
      <!-- The `&nbsp;` spaces avoid HTML whitespace collapse, which would
           otherwise glue the middot to the previous word ("Olivo·"). -->
      © {year}&nbsp;{AUTHOR}&nbsp;· Content&nbsp;<abbr
        title="Creative Commons Attribution 4.0">CC BY 4.0</abbr>&nbsp;·
      Code&nbsp;<abbr title="MIT License">MIT</abbr>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-block-start: auto; /* pushes the footer to the bottom on short pages */
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
  }

  a {
    color: inherit;
  }
</style>
