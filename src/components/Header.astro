---
// The header is intentionally minimal: the site name links home (the standard
// convention) and the theme selector sits at the top right.
import { SITE_TITLE } from "../consts";
---

<header class="site-header">
  <nav class="container">
    <a href="/">{SITE_TITLE}</a>

    <!--
      Theme selector: a radio GROUP (one value out of three — exactly the
      semantic), not three checkboxes. The base markup below statically
      renders the DEFAULT state ("system" checked); the script in
      BaseLayout.astro corrects it if a pinned theme is stored.

      Roving tabindex: exactly ONE button is tabbable (tabindex="0", the
      selected one). Arrow keys move both focus and selection inside the
      group — the standard radiogroup keyboard behaviour.
      Icons are inline SVG using currentColor, so they inherit the theme.
    -->
    <div id="theme-switch" class="theme-switch" role="radiogroup" aria-label="Color theme">
      <button type="button" role="radio" aria-checked="true" data-mode="system" tabindex="0"
        aria-label="Color theme: follow the system setting">
        <!-- Laptop/monitor: a screen on a stand -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8" />
          <path d="M12 17v4" />
        </svg>
      </button>
      <button type="button" role="radio" aria-checked="false" data-mode="light" tabindex="-1"
        aria-label="Color theme: light">
        <!-- Sun: circle + eight rays -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button type="button" role="radio" aria-checked="false" data-mode="dark" tabindex="-1"
        aria-label="Color theme: dark">
        <!-- Moon: classic crescent -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  /* Styles here are SCOPED: Astro rewrites this class name to a hashed value
     (e.g. .site-header[data-astro-x]) so this rule can never leak into other
     components. Global defaults live in global.css; only component-specific
     layout goes in a scoped block like this one. */
  header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  nav {
    display: flex;
    justify-content: space-between; /* name left, toggle right */
    align-items: center;
  }

  a {
    font-weight: 600;
    text-decoration: none;
    color: inherit; /* plain title, not accent-colored */
  }

  /* Segmented control: a rounded pill that contains the three icon buttons */
  .theme-switch {
    display: flex;
    gap: 0.125rem;
    padding: 0.125rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    color: var(--color-fg);
  }

  /* The selected option: a subtle tinted background. color-mix blends the
     foreground colour at 15% with transparency, so it works in both modes
     without defining another theme variable. */
  button[aria-checked="true"] {
    color: var(--color-fg);
    background: color-mix(in oklab, var(--color-fg) 15%, transparent);
  }

  svg {
    width: 1rem;
    height: 1rem;
  }
</style>
