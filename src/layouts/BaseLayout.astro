---
// BaseLayout.astro is wrapped around every page. A *layout* is just a normal
// component whose markup contains <slot />, the placeholder where the page
// that uses it injects its own content.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from "../consts";

// Pages pass values in as attributes: <BaseLayout title="..." description="...">
// They arrive pre-processed in `Astro.props`. The `interface Props` block
// documents the contract for TypeScript; optional fields get default values
// in the destructure below.
interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

// Full page title: browsers show only ~50-60 chars in tabs. The pattern is
// "page — site name"; on the home page that would render as
// "Fran T. Olivo — Fran T. Olivo", so there it stays just the site name.
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

// Canonical URL: the one address search engines should index, regardless of
// query strings or protocol. Astro.site comes from astro.config.mjs; if it
// were missing, new URL would throw at build time and fail the build loudly —
// better than silently rendering an empty canonical tag.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- lang tells screen readers and translation tools which language this is -->
<html lang="en">
  <head>
    <!-- charset must be first so the browser knows the encoding of the rest -->
    <meta charset="utf-8" />
    <!-- width=device-width: don't zoom out on phones; initial-scale=1: start at 100% -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Theme boot script. Must run BEFORE first paint: if the visitor pinned
      a theme last visit, we apply it here to avoid rendering one mode and
      then flashing the other (FOUC). is:inline keeps Astro from bundling or
      deferring it.

      No attribute on <html>  = follow the system (default)
      data-theme="light|dark" = pinned choice, CSS reacts via :root[data-theme]

      The one delegated click listener below survives anything the page adds
      later, so the header button needs no script of its own.
    -->
    <script is:inline>
      // All mode handling in one place. The <html> element carries the
      // current mode as data-theme (absent = "system" = follow the OS);
      // the radiogroup in Header.astro mirrors it via data-mode buttons.
      const MODES = ["system", "light", "dark"];

      function currentMode() {
        const t = document.documentElement.dataset.theme;
        return t === "light" || t === "dark" ? t : "system";
      }

      // Apply before first paint so there's no wrong-theme flash (FOUC).
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.theme = stored;
      }

      /** Writes the mode to <html> and storage; "system" removes the pin. */
      function setMode(mode) {
        if (mode === "system") {
          delete document.documentElement.dataset.theme;
          localStorage.removeItem("theme");
        } else {
          document.documentElement.dataset.theme = mode;
          localStorage.setItem("theme", mode);
        }
        renderThemeControls();
      }

      /** Syncs the segmented control to the current mode. */
      function renderThemeControls() {
        const mode = currentMode();
        const buttons = document.querySelectorAll("#theme-switch [role~='radio']");
        for (const btn of buttons) {
          const selected = btn.dataset.mode === mode;
          btn.setAttribute("aria-checked", String(selected));
          // Roving tabindex: only the selected radio is tabbable; arrow keys
          // move both focus and selection.
          btn.tabIndex = selected ? 0 : -1;
        }
      }

      // The buttons further down in <body> don't exist while this script (in
      // <head>) runs, so sync the static markup once the DOM is parsed.
      document.addEventListener("DOMContentLoaded", renderThemeControls);

      document.addEventListener("click", (ev) => {
        // `closest` needs the event target to be an element (not a text node)
        const btn =
          ev.target instanceof Element && ev.target.closest("#theme-switch [data-mode]");
        if (btn instanceof HTMLElement) setMode(btn.dataset.mode);
      });

      // Arrow keys inside the radiogroup: focus + selection move together
      // (see WAI-ARIA Authoring Practices for radio groups).
      const NEXT = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      document.addEventListener("keydown", (ev) => {
        const delta = NEXT[ev.key];
        if (!delta) return; // some other key
        const btn = ev.target instanceof Element && ev.target.closest("#theme-switch [data-mode]");
        if (!btn) return;
        ev.preventDefault(); // arrows are ours inside the group, not page scroll
        // % keeps the index inside 0-2 for both directions
        const i = MODES.indexOf(currentMode());
        setMode(MODES[(i + delta + MODES.length) % MODES.length]);
        document.querySelector(`#theme-switch [data-mode="${currentMode()}"]`).focus();
      });
    </script>

    <!-- Open Graph: how link previews look when shared on social/chat apps -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />

    <!-- Twitter/X card tags; "summary" shows a small card with title+description -->
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <!-- "Skip to content" is the first element on the page so Tab finds it
         immediately; the link itself lives in global.css (visually hidden
         until focused). -->
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <!-- id="main" is the target of the skip link above -->
    <main id="main">
      <!-- Whatever is inside <BaseLayout> on the page lands here -->
      <slot />
    </main>
    <Footer />
  </body>
</html>
